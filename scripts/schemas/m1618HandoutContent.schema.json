{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "m1618HandoutContent.json / m1618HandoutContent-en.json",
  "type": "object",
  "required": [
    "title",
    "subtitle",
    "briefSteps",
    "packetChecklist",
    "softDodChecks",
    "promptPatterns",
    "starterPrompt",
    "reflectionSummary",
    "nextPageHeading",
    "nextPageIntro",
    "primaryCtaLabel",
    "secondaryCtaLabels",
    "websiteUrl",
    "websiteCta",
    "footerText"
  ],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "briefSteps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "packetChecklist": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "softDodChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "promptPatterns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "starterPrompt": { "type": "string", "minLength": 1 },
    "reflectionSummary": { "type": "string", "minLength": 1 },
    "nextPageHeading": { "type": "string", "minLength": 1 },
    "nextPageIntro": { "type": "string", "minLength": 1 },
    "primaryCtaLabel": { "type": "string", "minLength": 1 },
    "secondaryCtaLabels": {
      "type": "object",
      "required": ["decide", "map"],
      "additionalProperties": false,
      "properties": {
        "decide": { "type": "string", "minLength": 1 },
        "map": { "type": "string", "minLength": 1 }
      }
    },
    "websiteUrl": { "type": "string", "format": "uri" },
    "websiteCta": { "type": "string", "minLength": 1 },
    "footerText": { "type": "string", "minLength": 1 }
  }
}
